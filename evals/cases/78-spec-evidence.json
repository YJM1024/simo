{
  "id": "spec-evidence",
  "name": "Spec 证据闭环（任务 done 写 evidence；无证据归档被拒，有证据放行；evidence 幂等）",
  "tier": "critical",
  "vars": {
    "probe": "evals-evidence-{{runId}}"
  },
  "steps": [
    {
      "type": "http",
      "method": "POST",
      "path": "/api/sessions",
      "body": {
        "title": "{{caseSession}}"
      },
      "expectStatus": [
        200,
        201
      ],
      "saveAs": "created"
    },
    {
      "type": "http",
      "method": "GET",
      "path": "/api/sessions",
      "expectStatus": 200,
      "saveAs": "sessions"
    },
    {
      "type": "capture",
      "from": "sessions.json.sessions",
      "whereContains": {
        "title": "{{caseSession}}"
      },
      "pick": "id",
      "saveAs": "sid"
    },
    {
      "type": "ws",
      "path": "/api/ws",
      "sessionId": "{{@sid}}",
      "chat": {
        "text": "{{probe}} mock:workflow 拆解任务并推进。"
      },
      "saveAs": "stream",
      "until": {
        "type": [
          "reply.done",
          "message.done"
        ],
        "timeoutMs": 45000
      },
      "drainMs": 400
    },
    {
      "type": "http",
      "method": "GET",
      "path": "/api/workflows?sessionId={{@sid}}",
      "expectStatus": 200,
      "saveAs": "wfList"
    },
    {
      "type": "capture",
      "from": "wfList.json.workflows",
      "where": {},
      "pick": "id",
      "saveAs": "workflowId"
    },
    {
      "type": "http",
      "method": "POST",
      "path": "/api/sessions/{{@sid}}/archive",
      "body": {},
      "expectStatus": [
        409,
        423
      ],
      "saveAs": "blocked"
    },
    {
      "type": "poll",
      "method": "GET",
      "path": "/api/workflows/{{@workflowId}}",
      "saveAs": "wfDone",
      "intervalMs": 500,
      "timeoutMs": 90000,
      "until": {
        "path": "json.workflow.tasks",
        "matchSome": {
          "title": "汇总产出",
          "status": "done"
        }
      }
    },
    {
      "type": "wait",
      "ms": 1200
    },
    {
      "type": "http",
      "method": "GET",
      "path": "/api/debug/spec?sessionId={{@sid}}",
      "expectStatus": 200,
      "saveAs": "specDone"
    },
    {
      "type": "capture",
      "from": "specDone.json.spec",
      "where": {},
      "pick": "evidence",
      "saveAs": "evidence1"
    },
    {
      "type": "http",
      "method": "GET",
      "path": "/api/debug/spec?sessionId={{@sid}}",
      "expectStatus": 200,
      "saveAs": "specDone2"
    },
    {
      "type": "capture",
      "from": "specDone2.json.spec",
      "where": {},
      "pick": "evidence",
      "saveAs": "evidence2"
    },
    {
      "type": "http",
      "method": "POST",
      "path": "/api/sessions/{{@sid}}/archive",
      "body": {},
      "expectStatus": [
        200,
        202,
        204
      ],
      "saveAs": "archived"
    }
  ],
  "graders": [
    {
      "type": "regex",
      "target": "blocked.body",
      "pattern": "archive_blocked|blockers"
    },
    {
      "type": "count",
      "target": "evidence1",
      "pattern": "task:",
      "atLeast": 1
    },
    {
      "type": "regex",
      "target": "specDone.body",
      "pattern": "\"allowed\"\\s*:\\s*true"
    },
    {
      "type": "regex",
      "target": "archived.body",
      "pattern": "\"ok\"\\s*:\\s*true|archived"
    },
    {
      "type": "count",
      "target": "evidence2",
      "pattern": "task:",
      "atLeast": 1
    }
  ]
}
