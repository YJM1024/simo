{
  "id": "message-session-label",
  "name": "消息会话标签（消息带 sessionId + sessionTitle，可据此跳转）",
  "tier": "normal",
  "vars": {
    "marker": "evals-label-{{runId}}",
    "lmsg": "evals-label-msg-{{runId}} 带标签的消息"
  },
  "steps": [
    {
      "type": "ws",
      "path": "/api/ws",
      "sessionId": "main",
      "collectAfterText": "{{marker}}",
      "chat": { "text": "我想创建一个新的需求：{{marker}} 整理客户反馈。" },
      "saveAs": "createStream",
      "until": { "type": ["reply.done", "message.done"], "timeoutMs": 20000 },
      "drainMs": 2000
    },
    { "type": "http", "method": "GET", "path": "/api/sessions/tree", "expectStatus": 200, "saveAs": "tree" },
    { "type": "capture", "from": ["tree.json.sessions", "tree.json.tree"], "mode": "array", "saveAs": "allSessions" },
    { "type": "capture", "from": "allSessions", "where": { "id": "main" }, "pick": "children", "saveAs": "mainChildren" },
    {
      "type": "capture",
      "from": "mainChildren",
      "whereContains": { "title": "{{marker}}" },
      "saveAs": "childNode"
    },
    { "type": "capture", "from": "mainChildren", "whereContains": { "title": "{{marker}}" }, "pick": "id", "saveAs": "childId" },
    {
      "type": "capture",
      "from": "mainChildren",
      "whereContains": { "title": "{{marker}}" },
      "pick": "title",
      "saveAs": "childTitle"
    },
    {
      "type": "ws",
      "path": "/api/ws",
      "sessionId": "{{@childId}}",
      "collectAfterText": "{{lmsg}}",
      "chat": { "text": "{{lmsg}}" },
      "saveAs": "msgStream",
      "until": { "type": ["reply.done", "message.done"], "timeoutMs": 20000 },
      "drainMs": 800
    },
    {
      "type": "http",
      "method": "GET",
      "path": "/api/messages?sessionId={{@childId}}",
      "expectStatus": 200,
      "saveAs": "msgs"
    }
  ],
  "graders": [
    { "type": "regex", "target": "msgs.body", "pattern": "\"sessionId\"\\s*:\\s*\"{{@childId}}\"" },
    { "type": "regex", "target": "msgs.body", "pattern": "\"sessionTitle\"\\s*:\\s*\"[^\"]+\"" },
    { "type": "regex", "target": "msgs.body", "pattern": "\"sessionTitle\"\\s*:\\s*\"{{@childTitle}}\"" },
    { "type": "regex", "target": "msgs.body", "pattern": "{{lmsg}}" },
    { "type": "state_delta", "collection": "msgs.json.messages", "where": { "sessionId": "{{@childId}}" }, "atLeast": 1 }
  ]
}
