{
  "id": "executor-config",
  "name": "执行器配置（默认 agent:task-npc；可配置 agent:simo；报告仍由会话负责人发出、NPC 无用户可见消息）",
  "tier": "normal",
  "vars": {
    "probe": "evals-exec-{{runId}}"
  },
  "steps": [
    { "type": "http", "method": "POST", "path": "/api/sessions", "body": { "title": "{{caseSession}}" }, "expectStatus": [200, 201], "saveAs": "created" },
    { "type": "http", "method": "GET", "path": "/api/sessions", "expectStatus": 200, "saveAs": "sessions" },
    { "type": "capture", "from": "sessions.json.sessions", "whereContains": { "title": "{{caseSession}}" }, "pick": "id", "saveAs": "sid" },

    { "type": "http", "method": "GET", "path": "/api/debug/spec?sessionId={{@sid}}", "expectStatus": 200, "saveAs": "specDefault" },
    { "type": "capture", "from": "specDefault.json.spec", "where": {}, "pick": "executorAgentId", "saveAs": "execDefault" },

    { "type": "http", "method": "POST", "path": "/api/debug/spec/executor", "body": { "sessionId": "{{@sid}}", "agentId": "agent:simo" }, "expectStatus": [200], "saveAs": "setExecutor" },
    { "type": "http", "method": "GET", "path": "/api/debug/spec?sessionId={{@sid}}", "expectStatus": 200, "saveAs": "specSimo" },
    { "type": "capture", "from": "specSimo.json.spec", "where": {}, "pick": "executorAgentId", "saveAs": "execSimo" },

    {
      "type": "ws",
      "path": "/api/ws",
      "sessionId": "{{@sid}}",
      "chat": { "text": "{{probe}} mock:workflow 拆解任务并推进。" },
      "saveAs": "wfStream",
      "until": { "type": ["reply.done", "message.done"], "timeoutMs": 45000 },
      "drainMs": 400
    },
    { "type": "http", "method": "GET", "path": "/api/workflows?sessionId={{@sid}}", "expectStatus": 200, "saveAs": "wfList" },
    { "type": "capture", "from": "wfList.json.workflows", "where": {}, "pick": "id", "saveAs": "workflowId" },
    {
      "type": "poll",
      "method": "GET",
      "path": "/api/workflows/{{@workflowId}}",
      "saveAs": "wfDone",
      "intervalMs": 500,
      "timeoutMs": 90000,
      "until": { "path": "json.workflow.tasks", "matchSome": { "title": "汇总产出", "status": "done" } }
    },
    { "type": "http", "method": "GET", "path": "/api/messages?sessionId={{@sid}}", "expectStatus": 200, "saveAs": "msgs" }
  ],
  "graders": [
    { "type": "regex", "target": "execDefault", "pattern": "^(agent:)?task-npc$|^$" },
    { "type": "regex", "target": "execSimo", "pattern": "^(agent:)?simo$" },
    { "type": "regex", "target": "setExecutor.body", "pattern": "\"ok\"\\s*:\\s*true" },
    { "type": "count", "target": "msgs.json.messages", "pattern": "\"role\"\\s*:\\s*\"agent\"", "atLeast": 1 },
    { "type": "forbidden", "target": "msgs.body", "patterns": ["\"agentId\"\\s*:\\s*\"(agent:)?task-npc\""] },
    { "type": "regex", "target": "msgs.body", "pattern": "\"agentId\"\\s*:\\s*\"simo\"" }
  ]
}
