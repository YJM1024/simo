{
  "id": "spec-hidden",
  "name": "Spec 对外不可见（公开 API 无 /api/specs；sessions/messages/overview/agents/stats 无 spec 字段）",
  "tier": "critical",
  "vars": {
    "probe": "evals-hidden-{{runId}}"
  },
  "steps": [
    {
      "type": "http",
      "method": "POST",
      "path": "/api/sessions",
      "body": {
        "title": "{{caseSession}}"
      },
      "expectStatus": [
        200,
        201
      ],
      "saveAs": "created"
    },
    {
      "type": "http",
      "method": "GET",
      "path": "/api/sessions",
      "expectStatus": 200,
      "saveAs": "sessions"
    },
    {
      "type": "capture",
      "from": "sessions.json.sessions",
      "whereContains": {
        "title": "{{caseSession}}"
      },
      "pick": "id",
      "saveAs": "sid"
    },
    {
      "type": "http",
      "method": "POST",
      "path": "/api/chat",
      "body": {
        "sessionId": "{{@sid}}",
        "text": "{{probe}} 你好。"
      },
      "expectStatus": [
        200,
        202
      ],
      "saveAs": "chat"
    },
    {
      "type": "poll",
      "method": "GET",
      "path": "/api/messages?sessionId={{@sid}}",
      "saveAs": "warm",
      "intervalMs": 300,
      "timeoutMs": 45000,
      "until": {
        "path": "json.messages",
        "matchSome": {
          "role": "agent"
        }
      }
    },
    {
      "type": "http",
      "method": "GET",
      "path": "/api/messages?sessionId={{@sid}}",
      "expectStatus": 200,
      "saveAs": "msgs"
    },
    {
      "type": "http",
      "method": "GET",
      "path": "/api/sessions/{{@sid}}/overview",
      "expectStatus": 200,
      "saveAs": "ov"
    },
    {
      "type": "http",
      "method": "GET",
      "path": "/api/agents",
      "expectStatus": 200,
      "saveAs": "agents"
    },
    {
      "type": "http",
      "method": "GET",
      "path": "/api/specs",
      "expectStatus": [
        404
      ],
      "saveAs": "specs"
    },
    {
      "type": "http",
      "method": "GET",
      "path": "/api/specs/spec-{{@sid}}",
      "expectStatus": [
        404
      ],
      "saveAs": "specDetail"
    },
    {
      "type": "http",
      "method": "GET",
      "path": "/api/sessions/{{@sid}}/spec",
      "expectStatus": [
        404
      ],
      "saveAs": "sessionSpec"
    }
  ],
  "graders": [
    {
      "type": "forbidden",
      "target": "specs.body",
      "patterns": [
        "\"ok\"\\s*:\\s*true"
      ]
    },
    {
      "type": "forbidden",
      "target": "specDetail.body",
      "patterns": [
        "\"ok\"\\s*:\\s*true"
      ]
    },
    {
      "type": "forbidden",
      "target": "sessionSpec.body",
      "patterns": [
        "\"ok\"\\s*:\\s*true"
      ]
    },
    {
      "type": "forbidden",
      "target": "sessions.body",
      "patterns": [
        "\"specId\"\\s*:",
        "\"specVersion\"\\s*:",
        "\"executorAgentId\"\\s*:",
        "\"stateReason\"\\s*:"
      ]
    },
    {
      "type": "forbidden",
      "target": "msgs.body",
      "patterns": [
        "\"specId\"\\s*:",
        "\"specVersion\"\\s*:",
        "\"stateReason\"\\s*:"
      ]
    },
    {
      "type": "forbidden",
      "target": "ov.body",
      "patterns": [
        "\"specId\"\\s*:",
        "\"specVersion\"\\s*:",
        "\"specCore\"\\s*:",
        "\"executorAgentId\"\\s*:",
        "\"acceptanceKeys\"\\s*:"
      ]
    },
    {
      "type": "forbidden",
      "target": "agents.body",
      "patterns": [
        "\"specId\"\\s*:",
        "\"specVersion\"\\s*:"
      ]
    }
  ]
}
