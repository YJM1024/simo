{
  "id": "session-overview",
  "name": "会话概览（completed/pending 为数组、timeline 为 [{at,text}] 且按时间有序；再次 GET 命中缓存）",
  "tier": "normal",
  "vars": {
    "probe": "evals-ov-{{runId}}"
  },
  "steps": [
    { "type": "http", "method": "POST", "path": "/api/sessions", "body": { "title": "{{caseSession}}" }, "expectStatus": [200, 201], "saveAs": "created" },
    { "type": "http", "method": "GET", "path": "/api/sessions", "expectStatus": 200, "saveAs": "sessions" },
    { "type": "capture", "from": "sessions.json.sessions", "whereContains": { "title": "{{caseSession}}" }, "pick": "id", "saveAs": "sid" },

    {
      "type": "ws",
      "path": "/api/ws",
      "sessionId": "{{@sid}}",
      "chat": { "text": "{{probe}} mock:workflow 拆解任务并推进。" },
      "saveAs": "wfStream",
      "until": { "type": ["reply.done", "message.done"], "timeoutMs": 45000 },
      "drainMs": 300
    },
    { "type": "http", "method": "GET", "path": "/api/workflows?sessionId={{@sid}}", "expectStatus": 200, "saveAs": "wfList" },
    { "type": "capture", "from": "wfList.json.workflows", "where": {}, "pick": "id", "saveAs": "workflowId" },
    {
      "type": "poll",
      "method": "GET",
      "path": "/api/workflows/{{@workflowId}}",
      "saveAs": "wfDetail",
      "intervalMs": 500,
      "timeoutMs": 90000,
      "until": { "path": "json.workflow.tasks", "matchSome": { "title": "汇总产出", "status": "done" } }
    },

    { "type": "http", "method": "GET", "path": "/api/sessions/{{@sid}}/overview", "expectStatus": 200, "saveAs": "emptyOverview" },
    { "type": "http", "method": "POST", "path": "/api/sessions/{{@sid}}/overview/refresh", "body": {}, "expectStatus": [200, 201], "saveAs": "refreshed" },
    { "type": "http", "method": "GET", "path": "/api/sessions/{{@sid}}/overview", "expectStatus": 200, "saveAs": "ov1" },
    { "type": "capture", "from": "ov1.json.overview", "where": {}, "pick": "version", "saveAs": "version1" },
    { "type": "capture", "from": "ov1.json.overview", "where": {}, "pick": "updatedAt", "saveAs": "updated1" },
    { "type": "capture", "from": "ov1.json.overview.timeline", "mode": "array", "saveAs": "timelineArr" },
    { "type": "capture", "from": "timelineArr", "where": {}, "pick": "at", "saveAs": "timelineFirstAt" },
    { "type": "capture", "from": "timelineArr", "last": true, "where": {}, "pick": "at", "saveAs": "timelineLastAt" },
    { "type": "http", "method": "GET", "path": "/api/sessions/{{@sid}}/overview", "expectStatus": 200, "saveAs": "ov2" },
    { "type": "capture", "from": "ov2.json.overview", "where": {}, "pick": "version", "saveAs": "version2" },
    { "type": "capture", "from": "ov2.json.overview", "where": {}, "pick": "updatedAt", "saveAs": "updated2" }
  ],
  "graders": [
    { "type": "regex", "target": "refreshed.body", "pattern": "\"goal\"\\s*:\\s*\"[^\"]{6,}\"" },
    { "type": "regex", "target": "ov1.body", "pattern": "\"constraints\"\\s*:\\s*\\[\\s*\"[^\"]{2,}\"" },
    { "type": "regex", "target": "ov1.body", "pattern": "\"current\"\\s*:\\s*\"[^\"]{6,}\"" },
    { "type": "regex", "target": "ov1.body", "pattern": "\"notes\"\\s*:\\s*\"[^\"]{2,}\"" },
    { "type": "regex", "target": "ov1.body", "pattern": "\"completed\"\\s*:\\s*\\[" },
    { "type": "regex", "target": "ov1.body", "pattern": "\"pending\"\\s*:\\s*\\[" },
    { "type": "regex", "target": "ov1.body", "pattern": "\"timeline\"\\s*:\\s*\\[\\s*\\{" },
    { "type": "regex", "target": "ov1.body", "pattern": "\"at\"\\s*:\\s*\\d{10,}" },
    { "type": "regex", "target": "ov1.body", "pattern": "\"text\"\\s*:\\s*\"[^\"]{2,}\"" },
    { "type": "count", "target": "timelineArr", "pattern": "\"at\"", "atLeast": 1 },
    { "type": "numeric", "left": "timelineLastAt", "op": "gte", "right": "timelineFirstAt" },
    { "type": "regex", "target": "ov1.body", "pattern": "。" },
    { "type": "forbidden", "target": "ov1.body", "patterns": ["(goal|constraints|current|notes)\"\\s*:\\s*\"[^\"]*[:：]"] },
    { "type": "numeric", "left": "version1", "op": "gte", "value": 1 },
    { "type": "numeric", "left": "version2", "op": "eq", "right": "version1" },
    { "type": "numeric", "left": "updated2", "op": "eq", "right": "updated1" }
  ]
}
