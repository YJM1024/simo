{
  "id": "runtime-stall",
  "name": "停滞检测（无进展 > 阈值 → paused(stall) + 会话汇报含卡点/选项；阈值用 debug 配置缩短）",
  "tier": "critical",
  "vars": {
    "probe": "evals-stall-{{runId}}"
  },
  "steps": [
    { "type": "http", "method": "POST", "path": "/api/sessions", "body": { "title": "{{caseSession}}" }, "expectStatus": [200, 201], "saveAs": "created" },
    { "type": "http", "method": "GET", "path": "/api/sessions", "expectStatus": 200, "saveAs": "sessions" },
    { "type": "capture", "from": "sessions.json.sessions", "whereContains": { "title": "{{caseSession}}" }, "pick": "id", "saveAs": "sid" },

    { "type": "http", "method": "POST", "path": "/api/debug/runtime/config", "body": { "stallWarnMs": 1000, "stallPauseMs": 2500 }, "expectStatus": [200], "saveAs": "cfg" },

    {
      "type": "ws",
      "path": "/api/ws",
      "sessionId": "{{@sid}}",
      "chat": { "text": "{{probe}} mock:stall" },
      "saveAs": "stream",
      "until": { "type": ["reply.done", "message.done"], "timeoutMs": 45000 },
      "drainMs": 400
    },
    { "type": "http", "method": "GET", "path": "/api/workflows?sessionId={{@sid}}", "expectStatus": 200, "saveAs": "wfList" },
    { "type": "capture", "from": "wfList.json.workflows", "where": {}, "pick": "id", "saveAs": "workflowId" },

    {
      "type": "poll",
      "method": "GET",
      "path": "/api/workflows/{{@workflowId}}/runtime",
      "saveAs": "wfRuntime",
      "intervalMs": 500,
      "timeoutMs": 60000,
      "until": { "path": "json.runtime", "matchSome": { "status": "paused" } }
    },
    { "type": "http", "method": "GET", "path": "/api/workflows/{{@workflowId}}", "expectStatus": 200, "saveAs": "wfDetail" },
    {
      "type": "poll",
      "method": "GET",
      "path": "/api/messages?sessionId={{@sid}}",
      "saveAs": "msgs",
      "intervalMs": 500,
      "timeoutMs": 30000,
      "until": { "path": "json.messages", "matchSome": { "role": "agent" } }
    }
  ],
  "graders": [
    { "type": "regex", "target": "cfg.body", "pattern": "\"ok\"\\s*:\\s*true" },
    { "type": "regex", "target": "wfRuntime.body", "pattern": "\"(stallState|stall)\"\\s*:\\s*\"(paused|escalated)\"" },
    { "type": "regex", "target": "wfDetail.body", "pattern": "\"status\"\\s*:\\s*\"paused\"" },
    { "type": "regex", "target": "msgs.body", "pattern": "(停滞|卡住|无进展|stall)" },
    { "type": "regex", "target": "msgs.body", "pattern": "(继续等|改派|人工接手|选项)" },
    { "type": "count", "target": "msgs.json.messages", "pattern": "\"role\"\\s*:\\s*\"agent\"", "atLeast": 1 }
  ]
}
