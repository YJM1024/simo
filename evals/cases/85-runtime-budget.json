{
  "id": "runtime-budget",
  "name": "预算熔断（工作流 token 软限很小 → 停新启动/等在飞、status=partial + final_summary 列未做项）",
  "tier": "normal",
  "vars": {
    "probe": "evals-budget-{{runId}}"
  },
  "steps": [
    { "type": "http", "method": "POST", "path": "/api/sessions", "body": { "title": "{{caseSession}}" }, "expectStatus": [200, 201], "saveAs": "created" },
    { "type": "http", "method": "GET", "path": "/api/sessions", "expectStatus": 200, "saveAs": "sessions" },
    { "type": "capture", "from": "sessions.json.sessions", "whereContains": { "title": "{{caseSession}}" }, "pick": "id", "saveAs": "sid" },

    { "type": "http", "method": "POST", "path": "/api/debug/runtime/config", "body": { "workflowTokenBudget": 1 }, "expectStatus": [200], "saveAs": "cfg" },

    {
      "type": "ws",
      "path": "/api/ws",
      "sessionId": "{{@sid}}",
      "chat": { "text": "{{probe}} mock:budget-burn 拆解任务并推进。" },
      "saveAs": "stream",
      "until": { "type": ["reply.done", "message.done"], "timeoutMs": 45000 },
      "drainMs": 400
    },
    { "type": "http", "method": "GET", "path": "/api/workflows?sessionId={{@sid}}", "expectStatus": 200, "saveAs": "wfList" },
    { "type": "capture", "from": "wfList.json.workflows", "where": {}, "pick": "id", "saveAs": "workflowId" },
    {
      "type": "poll",
      "method": "GET",
      "path": "/api/workflows/{{@workflowId}}",
      "saveAs": "wfDone",
      "intervalMs": 500,
      "timeoutMs": 90000,
      "until": { "path": "json.workflow", "matchSome": { "status": "partial" } }
    },
    { "type": "http", "method": "GET", "path": "/api/workflows/{{@workflowId}}/runtime", "expectStatus": 200, "saveAs": "wfRuntime" },
    {
      "type": "poll",
      "method": "GET",
      "path": "/api/messages?sessionId={{@sid}}",
      "saveAs": "msgs",
      "intervalMs": 500,
      "timeoutMs": 30000,
      "until": { "path": "json.messages", "matchSome": { "role": "agent" } }
    }
  ],
  "graders": [
    { "type": "regex", "target": "cfg.body", "pattern": "\"ok\"\\s*:\\s*true" },
    { "type": "regex", "target": "wfDone.body", "pattern": "\"status\"\\s*:\\s*\"partial\"" },
    { "type": "regex", "target": "wfRuntime.body", "pattern": "\"(budget|budgetRemaining|budgetUsed)\"" },
    { "type": "regex", "target": "msgs.body", "pattern": "(预算|未做|没做|partial|部分完成)" },
    { "type": "forbidden", "target": "wfDone.body", "patterns": ["\"status\"\\s*:\\s*\"done\""] }
  ]
}
