{
  "id": "web-ssrf",
  "name": "SSRF 防护（127.0.0.1 与 169.254.169.254 审批后被拒，不泄露内网内容）",
  "tier": "critical",
  "vars": {
    "probe": "evals-ssrf-{{runId}}"
  },
  "steps": [
    { "type": "http", "method": "POST", "path": "/api/sessions", "body": { "title": "{{caseSession}}" }, "expectStatus": [200, 201], "saveAs": "created" },
    { "type": "http", "method": "GET", "path": "/api/sessions", "expectStatus": 200, "saveAs": "sessions" },
    { "type": "capture", "from": "sessions.json.sessions", "whereContains": { "title": "{{caseSession}}" }, "pick": "id", "saveAs": "sid" },

    {
      "type": "ws",
      "path": "/api/ws",
      "sessionId": "{{@sid}}",
      "chat": { "text": "mock:web-fetch http://127.0.0.1:8787/api/health" },
      "saveAs": "s1",
      "until": { "type": ["reply.done", "message.done"], "timeoutMs": 60000 },
      "drainMs": 500
    },
    {
      "type": "poll",
      "method": "GET",
      "path": "/api/approvals",
      "saveAs": "p1",
      "intervalMs": 300,
      "timeoutMs": 20000,
      "until": { "path": "json.approvals", "matchSome": { "tool": "web_fetch", "status": "pending" } }
    },
    { "type": "capture", "from": "p1.json.approvals", "where": { "tool": "web_fetch", "status": "pending" }, "pick": "id", "saveAs": "a1" },
    { "type": "http", "method": "POST", "path": "/api/approvals/{{@a1}}", "body": { "decision": "allow" }, "expectStatus": 200, "timeoutMs": 60000, "saveAs": "r1" },

    {
      "type": "ws",
      "path": "/api/ws",
      "sessionId": "{{@sid}}",
      "chat": { "text": "mock:web-fetch http://169.254.169.254/latest/meta-data/" },
      "saveAs": "s2",
      "until": { "type": ["reply.done", "message.done"], "timeoutMs": 60000 },
      "drainMs": 500
    },
    {
      "type": "poll",
      "method": "GET",
      "path": "/api/approvals",
      "saveAs": "p2",
      "intervalMs": 300,
      "timeoutMs": 20000,
      "until": { "path": "json.approvals", "matchSome": { "tool": "web_fetch", "status": "pending" } }
    },
    { "type": "capture", "from": "p2.json.approvals", "where": { "tool": "web_fetch", "status": "pending" }, "pick": "id", "saveAs": "a2" },
    { "type": "http", "method": "POST", "path": "/api/approvals/{{@a2}}", "body": { "decision": "allow" }, "expectStatus": 200, "timeoutMs": 60000, "saveAs": "r2" }
  ],
  "graders": [
    { "type": "regex", "target": "r1.body", "pattern": "(ssrf|forbidden|私网|内网|环回|loopback|private|blocked|拒绝)", "flags": "is" },
    { "type": "forbidden", "target": "r1.body", "patterns": ["\"ready\"\\s*:\\s*true", "\"modules\"\\s*:\\s*\\["] },
    { "type": "regex", "target": "r2.body", "pattern": "(ssrf|forbidden|私网|内网|环回|loopback|link-local|blocked|拒绝)", "flags": "is" },
    { "type": "forbidden", "target": "r2.body", "patterns": ["ami-id", "security-credentials", "instance-id"] },
    { "type": "forbidden", "target": "r1.body", "patterns": ["\"ok\"\\s*:\\s*true[^}]*\"text\"\\s*:\\s*\"\\{"] }
  ]
}
