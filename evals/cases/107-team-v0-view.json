{
  "id": "team-v0-view",
  "name": "团队 V0 视图（GET /api/team、/api/workflows/{id}/members 形状：agentId/name/role/status/progress/stateReason/taskId/workflowId）",
  "tier": "critical",
  "vars": {
    "probe": "evals-team-{{runId}}"
  },
  "steps": [
    { "type": "http", "method": "POST", "path": "/api/sessions", "body": { "title": "{{caseSession}}" }, "expectStatus": [200, 201], "saveAs": "created" },
    { "type": "http", "method": "GET", "path": "/api/sessions", "expectStatus": 200, "saveAs": "sessions" },
    { "type": "capture", "from": "sessions.json.sessions", "whereContains": { "title": "{{caseSession}}" }, "pick": "id", "saveAs": "sid" },
    {
      "type": "ws",
      "path": "/api/ws",
      "sessionId": "{{@sid}}",
      "chat": { "text": "{{probe}} mock:workflow 拆解任务并推进。" },
      "saveAs": "stream",
      "until": { "type": ["reply.done", "message.done"], "timeoutMs": 45000 },
      "drainMs": 400
    },
    { "type": "http", "method": "GET", "path": "/api/workflows?sessionId={{@sid}}", "expectStatus": 200, "saveAs": "wfList" },
    { "type": "capture", "from": "wfList.json.workflows", "where": {}, "pick": "id", "saveAs": "workflowId" },
    {
      "type": "poll",
      "method": "GET",
      "path": "/api/team?sessionId={{@sid}}",
      "saveAs": "team",
      "intervalMs": 300,
      "timeoutMs": 20000,
      "until": { "path": "json.members", "matchSome": { "role": "task" } }
    },
    { "type": "http", "method": "GET", "path": "/api/workflows/{{@workflowId}}/members", "expectStatus": 200, "saveAs": "members" }
  ],
  "graders": [
    { "type": "regex", "target": "team.body", "pattern": "\"members\"\\s*:\\s*\\[" },
    { "type": "count", "target": "team.json.members", "pattern": "\"taskId\"", "atLeast": 1 },
    { "type": "regex", "target": "team.body", "pattern": "\"agentId\"\\s*:\\s*\"[^\"]+\"" },
    { "type": "regex", "target": "team.body", "pattern": "\"name\"\\s*:\\s*\"[^\"]+\"" },
    { "type": "regex", "target": "team.body", "pattern": "\"role\"\\s*:\\s*\"task\"" },
    { "type": "regex", "target": "team.body", "pattern": "\"status\"\\s*:\\s*\"(pending|queued|running|done|failed|paused|blocked)\"" },
    { "type": "regex", "target": "team.body", "pattern": "\"progress\"\\s*:" },
    { "type": "regex", "target": "team.body", "pattern": "\"stateReason\"\\s*:" },
    { "type": "regex", "target": "team.body", "pattern": "\"globalConcurrency\"\\s*:" },
    { "type": "regex", "target": "members.body", "pattern": "\"workflowId\"\\s*:\\s*\"wf-" },
    { "type": "regex", "target": "members.body", "pattern": "\"members\"\\s*:\\s*\\[" }
  ]
}
