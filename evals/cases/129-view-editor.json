{
  "id": "view-editor",
  "name": "M28 视图编辑：set_view patch(add/remove/replace) + 409 baseVersion + rollback 版本内容一致",
  "tier": "critical",
  "vars": {
    "title1": "编辑器-{{runId}}",
    "title2": "编辑器改-{{runId}}"
  },
  "steps": [
    {
      "type": "http", "method": "POST", "path": "/api/actions/ui.set_view", "expectStatus": 200, "saveAs": "created",
      "body": {
        "sessionId": "main", "mode": "create", "reason": "M28 验收：创建可编辑视图",
        "schema": {
          "schemaVersion": 1, "id": "view-main-m28-{{runId}}", "sessionId": "main", "title": "{{title1}}",
          "layout": { "kind": "rows" },
          "blocks": [
            { "id": "t1", "type": "text", "props": { "text": "one" } },
            { "id": "t2", "type": "text", "props": { "text": "two" } }
          ],
          "equivalence": { "chatPrompt": "show editor page" },
          "meta": { "createdBy": "agent" }
        }
      }
    },
    { "type": "capture", "from": "created.json.data", "pick": "pageId", "saveAs": "pageId" },
    {
      "type": "http", "method": "POST", "path": "/api/actions/ui.set_view", "expectStatus": 200, "saveAs": "patched",
      "body": {
        "sessionId": "main", "mode": "patch", "pageId": "{{@pageId}}", "baseVersion": 1, "reason": "add/remove/set",
        "patch": { "ops": [
          { "op": "add_block", "after": "t1", "block": { "id": "t3", "type": "text", "props": { "text": "three" } } },
          { "op": "remove_block", "blockId": "t2" },
          { "op": "set_block_props", "blockId": "t1", "props": { "text": "one-edited" } }
        ] }
      }
    },
    { "type": "http", "method": "GET", "path": "/api/views/{{@pageId}}", "expectStatus": 200, "saveAs": "page2" },
    {
      "type": "http", "method": "POST", "path": "/api/actions/ui.set_view", "expectStatus": 200, "saveAs": "replaced",
      "body": {
        "sessionId": "main", "mode": "patch", "pageId": "{{@pageId}}", "baseVersion": 2, "reason": "replace blocks",
        "patch": { "ops": [
          { "op": "replace_blocks", "blocks": [ { "id": "t9", "type": "text", "props": { "text": "nine" } } ] },
          { "op": "set_page_props", "title": "{{title2}}" }
        ] }
      }
    },
    { "type": "http", "method": "GET", "path": "/api/views/{{@pageId}}", "expectStatus": 200, "saveAs": "page3" },
    {
      "type": "http", "method": "POST", "path": "/api/actions/ui.set_view", "expectStatus": 409, "saveAs": "conflict",
      "body": {
        "sessionId": "main", "mode": "patch", "pageId": "{{@pageId}}", "baseVersion": 1, "reason": "过期 baseVersion",
        "patch": { "ops": [ { "op": "set_page_props", "title": "不该生效" } ] }
      }
    },
    {
      "type": "http", "method": "POST", "path": "/api/actions/ui.view.rollback", "expectStatus": 200, "saveAs": "rollback",
      "body": { "sessionId": "main", "mode": "rollback", "pageId": "{{@pageId}}", "baseVersion": 3, "targetVersion": 2, "reason": "回滚到 v2" }
    },
    { "type": "http", "method": "GET", "path": "/api/views/{{@pageId}}", "expectStatus": 200, "saveAs": "page4" },
    { "type": "http", "method": "GET", "path": "/api/views/{{@pageId}}/versions", "expectStatus": 200, "saveAs": "versions" }
  ],
  "graders": [
    { "type": "regex", "target": "created.body", "pattern": "\"version\"\\s*:\\s*1" },
    { "type": "regex", "target": "patched.body", "pattern": "\"version\"\\s*:\\s*2" },
    { "type": "regex", "target": "page2.body", "pattern": "\"version\"\\s*:\\s*2" },
    { "type": "regex", "target": "page2.body", "pattern": "\"id\"\\s*:\\s*\"t3\"" },
    { "type": "regex", "target": "page2.body", "pattern": "one-edited" },
    { "type": "forbidden", "target": "page2.body", "patterns": ["\"id\"\\s*:\\s*\"t2\""] },
    { "type": "regex", "target": "replaced.body", "pattern": "\"version\"\\s*:\\s*3" },
    { "type": "regex", "target": "page3.body", "pattern": "\"version\"\\s*:\\s*3" },
    { "type": "regex", "target": "page3.body", "pattern": "\"title\"\\s*:\\s*\"{{title2}}\"" },
    { "type": "regex", "target": "page3.body", "pattern": "\"id\"\\s*:\\s*\"t9\"" },
    { "type": "forbidden", "target": "page3.body", "patterns": ["\"id\"\\s*:\\s*\"t1\""] },
    { "type": "regex", "target": "conflict.body", "pattern": "VIEW_BASE_CONFLICT" },
    { "type": "regex", "target": "rollback.body", "pattern": "\"version\"\\s*:\\s*4" },
    { "type": "regex", "target": "page4.body", "pattern": "\"version\"\\s*:\\s*4" },
    { "type": "regex", "target": "page4.body", "pattern": "\"title\"\\s*:\\s*\"{{title1}}\"" },
    { "type": "regex", "target": "page4.body", "pattern": "\"id\"\\s*:\\s*\"t1\"" },
    { "type": "regex", "target": "page4.body", "pattern": "\"id\"\\s*:\\s*\"t3\"" },
    { "type": "forbidden", "target": "page4.body", "patterns": ["\"id\"\\s*:\\s*\"t9\""] },
    { "type": "count", "target": "versions.json.versions", "pattern": "\"version\"", "exactly": 4 }
  ]
}
