{
  "id": "schedule-failclosed",
  "name": "fail-closed（定时触发需审批但无人应答 → 状态 failed、schedule 自动暂停、会话收到汇报）",
  "tier": "normal",
  "vars": {
    "probe": "evals-failclosed-{{runId}}",
    "prompt": "mock:write 定时写文件 {{probe}}"
  },
  "steps": [
    { "type": "http", "method": "POST", "path": "/api/sessions", "body": { "title": "{{caseSession}}" }, "expectStatus": [200, 201], "saveAs": "created" },
    { "type": "http", "method": "GET", "path": "/api/sessions", "expectStatus": 200, "saveAs": "sessions" },
    { "type": "capture", "from": "sessions.json.sessions", "whereContains": { "title": "{{caseSession}}" }, "pick": "id", "saveAs": "sid" },
    {
      "type": "http",
      "method": "POST",
      "path": "/api/schedules",
      "body": {
        "sessionId": "{{@sid}}",
        "title": "evals-failclosed",
        "prompt": "{{prompt}}",
        "trigger": { "type": "once", "expr": "{{nowPlusIso:5}}" }
      },
      "expectStatus": [200, 201],
      "saveAs": "createdSch"
    },
    { "type": "capture", "from": "createdSch.json.schedule", "where": {}, "pick": "id", "saveAs": "schId" },
    {
      "type": "poll",
      "method": "GET",
      "path": "/api/schedules/{{@schId}}",
      "saveAs": "failed",
      "intervalMs": 500,
      "timeoutMs": 90000,
      "until": { "path": "json.schedule", "matchSome": { "id": "{{@schId}}", "lastStatus": "failed" } }
    },
    { "type": "http", "method": "GET", "path": "/api/schedules/{{@schId}}", "expectStatus": 200, "saveAs": "detail" },
    { "type": "http", "method": "GET", "path": "/api/approvals", "expectStatus": 200, "saveAs": "approvals" },
    { "type": "http", "method": "GET", "path": "/api/messages?sessionId={{@sid}}", "expectStatus": 200, "saveAs": "msgs" }
  ],
  "graders": [
    { "type": "regex", "target": "detail.body", "pattern": "\"lastStatus\"\\s*:\\s*\"failed\"" },
    { "type": "regex", "target": "detail.body", "pattern": "\"enabled\"\\s*:\\s*false" },
    { "type": "regex", "target": "detail.body", "pattern": "\"nextRunAt\"\\s*:\\s*0" },
    { "type": "state_delta", "collection": "approvals.json.approvals", "where": { "status": "pending" }, "atLeast": 1 },
    { "type": "regex", "target": "msgs.body", "pattern": "(需要审批|无人应答|自动暂停)" }
  ]
}
