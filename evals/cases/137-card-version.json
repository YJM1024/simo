{
  "id": "card-version",
  "name": "M41 卡片版本：PATCH → version+1 + WS card.updated；过期 baseVersion → 409",
  "tier": "critical",
  "vars": {
    "probe": "evals-card-version-{{runId}}"
  },
  "steps": [
    {
      "type": "http",
      "method": "POST",
      "path": "/api/actions/chat.send_card",
      "expectStatus": [
        200,
        201
      ],
      "saveAs": "sent",
      "body": {
        "sessionId": "{{caseSession}}",
        "fallbackText": "版本一（兜底）。",
        "schema": {
          "schemaVersion": 1,
          "title": "版本一",
          "blocks": [
            {
              "id": "t1",
              "type": "text",
              "props": {
                "text": "v1"
              }
            }
          ],
          "actions": [
            {
              "id": "confirm",
              "label": "确认",
              "route": "agent",
              "action": "chat.send",
              "prompt": "确认版本",
              "variant": "primary"
            }
          ],
          "equivalence": {
            "chatPrompt": "确认版本"
          },
          "layout": {
            "kind": "rows"
          }
        }
      }
    },
    {
      "type": "capture",
      "from": "sent.json.data",
      "pick": "cardId",
      "saveAs": "cardId"
    },
    {
      "type": "capture",
      "from": "sent.json.data",
      "pick": "messageId",
      "saveAs": "messageId"
    },
    {
      "type": "http",
      "method": "PATCH",
      "path": "/api/cards/{{@cardId}}",
      "expectStatus": 200,
      "saveAs": "patched",
      "body": {
        "baseVersion": 1,
        "fallbackText": "版本二（兜底）。",
        "reason": "agent update",
        "schema": {
          "schemaVersion": 1,
          "title": "版本二",
          "blocks": [
            {
              "id": "t1",
              "type": "text",
              "props": {
                "text": "v2"
              }
            }
          ],
          "actions": [
            {
              "id": "confirm",
              "label": "确认",
              "route": "agent",
              "action": "chat.send",
              "prompt": "确认版本二",
              "variant": "primary"
            }
          ],
          "equivalence": {
            "chatPrompt": "确认版本二"
          },
          "layout": {
            "kind": "rows"
          }
        }
      }
    },
    {
      "type": "http",
      "method": "GET",
      "path": "/api/cards/{{@cardId}}",
      "expectStatus": 200,
      "saveAs": "card"
    },
    {
      "type": "ws",
      "path": "/api/ws?since=0",
      "sessionId": "{{caseSession}}",
      "saveAs": "stream",
      "until": {
        "type": [
          "card.updated"
        ],
        "timeoutMs": 8000
      },
      "drainMs": 200
    },
    {
      "type": "http",
      "method": "PATCH",
      "path": "/api/cards/{{@cardId}}",
      "expectStatus": 409,
      "saveAs": "conflict",
      "body": {
        "baseVersion": 1,
        "fallbackText": "过期（兜底）。",
        "reason": "stale update",
        "schema": {
          "schemaVersion": 1,
          "title": "过期版本",
          "blocks": [
            {
              "id": "t1",
              "type": "text",
              "props": {
                "text": "stale"
              }
            }
          ],
          "actions": [
            {
              "id": "confirm",
              "label": "确认",
              "route": "agent",
              "action": "chat.send",
              "prompt": "确认",
              "variant": "primary"
            }
          ],
          "equivalence": {
            "chatPrompt": "确认"
          },
          "layout": {
            "kind": "rows"
          }
        }
      }
    }
  ],
  "graders": [
    {
      "type": "regex",
      "target": "sent.body",
      "pattern": "\"ok\"\\s*:\\s*true"
    },
    {
      "type": "regex",
      "target": "patched.body",
      "pattern": "\"version\"\\s*:\\s*2"
    },
    {
      "type": "regex",
      "target": "card.body",
      "pattern": "\"version\"\\s*:\\s*2"
    },
    {
      "type": "regex",
      "target": "card.body",
      "pattern": "版本二"
    },
    {
      "type": "regex",
      "target": "stream.raw",
      "pattern": "\"type\"\\s*:\\s*\"card.updated\""
    },
    {
      "type": "regex",
      "target": "stream.raw",
      "pattern": "{{@cardId}}"
    },
    {
      "type": "regex",
      "target": "conflict.body",
      "pattern": "CARD_BASE_CONFLICT"
    }
  ]
}
