{
  "id": "python-basic",
  "name": "Python 基本执行（run_python 审批 allow → 输出 + [exit code: 0]）",
  "tier": "critical",
  "vars": {
    "probe": "evals-pybasic-{{runId}}"
  },
  "steps": [
    {
      "type": "ws",
      "path": "/api/ws",
      "sessionId": "{{caseSession}}",
      "collectAfterText": "{{probe}}",
      "chat": {
        "text": "{{probe}} mock:python:print('hello from python')"
      },
      "saveAs": "stream",
      "until": {
        "type": [
          "reply.done",
          "message.done",
          "error"
        ],
        "timeoutMs": 45000
      },
      "drainMs": 1200
    },
    {
      "type": "poll",
      "method": "GET",
      "path": "/api/approvals",
      "saveAs": "pending",
      "intervalMs": 200,
      "timeoutMs": 15000,
      "until": {
        "path": "json.approvals",
        "matchSome": {
          "tool": "run_python",
          "status": "pending"
        }
      }
    },
    {
      "type": "capture",
      "from": "pending.json.approvals",
      "where": {
        "tool": "run_python",
        "status": "pending"
      },
      "pick": "id",
      "saveAs": "approvalId"
    },
    {
      "type": "http",
      "method": "POST",
      "path": "/api/approvals/{{@approvalId}}",
      "body": {
        "decision": "allow"
      },
      "expectStatus": 200,
      "timeoutMs": 60000,
      "saveAs": "allowResp"
    },
    {
      "type": "poll",
      "method": "GET",
      "path": "/api/approvals",
      "saveAs": "approved",
      "intervalMs": 200,
      "timeoutMs": 30000,
      "until": {
        "path": "json.approvals",
        "matchSome": {
          "id": "{{@approvalId}}",
          "status": "approved"
        }
      }
    },
    {
      "type": "poll",
      "method": "GET",
      "path": "/api/approvals",
      "saveAs": "approved",
      "intervalMs": 200,
      "timeoutMs": 30000,
      "until": {
        "path": "json.approvals",
        "matchSome": {
          "id": "{{@approvalId}}",
          "status": "approved"
        }
      }
    },
    {
      "type": "http",
      "method": "GET",
      "path": "/api/approvals",
      "expectStatus": 200,
      "saveAs": "finalBody"
    },
    {
      "type": "capture",
      "from": "finalBody.json.approvals",
      "where": {
        "id": "{{@approvalId}}"
      },
      "pick": "result",
      "saveAs": "resultText"
    }
  ],
  "graders": [
    {
      "type": "regex",
      "target": "allowResp.body",
      "pattern": "\"status\"\\s*:\\s*\"approved\""
    },
    {
      "type": "regex",
      "target": "resultText",
      "pattern": "hello from python"
    },
    {
      "type": "regex",
      "target": "resultText",
      "pattern": "\\[exit code:\\s*0\\]"
    },
    {
      "type": "forbidden",
      "target": "resultText",
      "patterns": [
        "code=python_missing",
        "code=spawn_failed",
        "code=TIMEOUT"
      ]
    }
  ]
}
