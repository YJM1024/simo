{
  "id": "aggregate-view",
  "name": "聚合视图（includeChildren=true 含根+子并按时间排序；false 仅根）",
  "tier": "normal",
  "vars": {
    "marker": "evals-agg-{{runId}}",
    "pmsg": "evals-agg-parent-{{runId}} 父会话先发",
    "cmsg": "evals-agg-child-{{runId}} 子会话后发"
  },
  "steps": [
    {
      "type": "ws",
      "path": "/api/ws",
      "sessionId": "main",
      "collectAfterText": "{{marker}}",
      "chat": { "text": "我想创建一个新的需求：{{marker}} 汇总季度培训记录。" },
      "saveAs": "createStream",
      "until": { "type": ["reply.done", "message.done"], "timeoutMs": 20000 },
      "drainMs": 2000
    },
    { "type": "http", "method": "GET", "path": "/api/sessions/tree", "expectStatus": 200, "saveAs": "tree" },
    { "type": "capture", "from": ["tree.json.sessions", "tree.json.tree"], "mode": "array", "saveAs": "allSessions" },
    { "type": "capture", "from": "allSessions", "where": { "id": "main" }, "pick": "children", "saveAs": "mainChildren" },
    { "type": "capture", "from": "mainChildren", "whereContains": { "title": "{{marker}}" }, "pick": "id", "saveAs": "childId" },
    {
      "type": "ws",
      "path": "/api/ws",
      "sessionId": "main",
      "collectAfterText": "{{pmsg}}",
      "chat": { "text": "{{pmsg}}" },
      "saveAs": "parentStream",
      "until": { "type": ["reply.done", "message.done"], "timeoutMs": 20000 },
      "drainMs": 800
    },
    {
      "type": "ws",
      "path": "/api/ws",
      "sessionId": "{{@childId}}",
      "collectAfterText": "{{cmsg}}",
      "chat": { "text": "{{cmsg}}" },
      "saveAs": "childStream",
      "until": { "type": ["reply.done", "message.done"], "timeoutMs": 20000 },
      "drainMs": 800
    },
    {
      "type": "http",
      "method": "GET",
      "path": "/api/messages?sessionId=main&includeChildren=true",
      "expectStatus": 200,
      "saveAs": "agg"
    },
    {
      "type": "http",
      "method": "GET",
      "path": "/api/messages?sessionId=main&includeChildren=false",
      "expectStatus": 200,
      "saveAs": "onlyMain"
    }
  ],
  "graders": [
    { "type": "regex", "target": "agg.body", "pattern": "{{pmsg}}" },
    { "type": "regex", "target": "agg.body", "pattern": "{{cmsg}}" },
    { "type": "state_delta", "collection": "agg.json.messages", "where": { "sessionId": "{{@childId}}" }, "atLeast": 1 },
    { "type": "regex", "target": "agg.body", "pattern": "{{pmsg}}[\\s\\S]*{{cmsg}}" },
    { "type": "regex", "target": "onlyMain.body", "pattern": "{{pmsg}}" },
    { "type": "forbidden", "target": "onlyMain.body", "patterns": ["{{cmsg}}"] }
  ]
}
