{
  "id": "card-idempotency",
  "name": "M41 卡片幂等：同 cardId+actionId+payload 重复提交只执行一次",
  "tier": "critical",
  "vars": {
    "probe": "evals-card-idem-{{runId}}"
  },
  "steps": [
    {
      "type": "http",
      "method": "POST",
      "path": "/api/actions/chat.send_card",
      "expectStatus": [
        200,
        201
      ],
      "saveAs": "sent",
      "body": {
        "sessionId": "{{caseSession}}",
        "fallbackText": "幂等确认（兜底）。",
        "schema": {
          "schemaVersion": 1,
          "title": "幂等确认",
          "blocks": [
            {
              "id": "t1",
              "type": "text",
              "props": {
                "text": "请确认一次"
              }
            }
          ],
          "actions": [
            {
              "id": "confirm",
              "label": "确认",
              "route": "agent",
              "action": "chat.send",
              "prompt": "确认一次",
              "variant": "primary"
            }
          ],
          "equivalence": {
            "chatPrompt": "确认一次"
          },
          "layout": {
            "kind": "rows"
          }
        }
      }
    },
    {
      "type": "capture",
      "from": "sent.json.data",
      "pick": "cardId",
      "saveAs": "cardId"
    },
    {
      "type": "capture",
      "from": "sent.json.data",
      "pick": "messageId",
      "saveAs": "messageId"
    },
    {
      "type": "http",
      "method": "POST",
      "path": "/api/cards/{{@cardId}}/actions/confirm",
      "expectStatus": [
        200,
        202
      ],
      "saveAs": "first",
      "body": {
        "messageId": "{{@messageId}}",
        "baseVersion": 1,
        "payload": {
          "value": "same"
        },
        "idempotencyKey": "idem-key-{{runId}}"
      }
    },
    {
      "type": "http",
      "method": "POST",
      "path": "/api/cards/{{@cardId}}/actions/confirm",
      "expectStatus": [
        200,
        202
      ],
      "saveAs": "second",
      "body": {
        "messageId": "{{@messageId}}",
        "baseVersion": 1,
        "payload": {
          "value": "same"
        },
        "idempotencyKey": "idem-key-{{runId}}"
      }
    },
    {
      "type": "wait",
      "ms": 2500
    },
    {
      "type": "http",
      "method": "GET",
      "path": "/api/messages?sessionId={{caseSession}}",
      "expectStatus": 200,
      "saveAs": "after"
    }
  ],
  "graders": [
    {
      "type": "regex",
      "target": "sent.body",
      "pattern": "\"ok\"\\s*:\\s*true"
    },
    {
      "type": "regex",
      "target": "first.body",
      "pattern": "\"route\"\\s*:\\s*\"agent\""
    },
    {
      "type": "regex",
      "target": "second.body",
      "pattern": "\"idempotent\"\\s*:\\s*true"
    },
    {
      "type": "count",
      "target": "after.json.messages",
      "pattern": "\"role\"\\s*:\\s*\"user\"[^}]*actionId=confirm",
      "exactly": 1
    },
    {
      "type": "count",
      "target": "after.json.messages",
      "pattern": "\"role\"\\s*:\\s*\"agent\"",
      "atLeast": 2
    }
  ]
}
