{
  "id": "web-fetch",
  "name": "联网抓取（web_fetch 审批后抓公开页：含 status/contentType/正文，或结构化网络错误）",
  "tier": "normal",
  "vars": {
    "probe": "evals-fetch-{{runId}}",
    "url": "https://example.com/"
  },
  "steps": [
    { "type": "http", "method": "POST", "path": "/api/sessions", "body": { "title": "{{caseSession}}" }, "expectStatus": [200, 201], "saveAs": "created" },
    { "type": "http", "method": "GET", "path": "/api/sessions", "expectStatus": 200, "saveAs": "sessions" },
    { "type": "capture", "from": "sessions.json.sessions", "whereContains": { "title": "{{caseSession}}" }, "pick": "id", "saveAs": "sid" },
    {
      "type": "ws",
      "path": "/api/ws",
      "sessionId": "{{@sid}}",
      "chat": { "text": "mock:web-fetch {{url}}" },
      "saveAs": "stream",
      "until": { "type": ["reply.done", "message.done"], "timeoutMs": 90000 },
      "drainMs": 800
    },
    {
      "type": "poll",
      "method": "GET",
      "path": "/api/approvals",
      "saveAs": "pending",
      "intervalMs": 300,
      "timeoutMs": 20000,
      "until": { "path": "json.approvals", "matchSome": { "tool": "web_fetch", "status": "pending" } }
    },
    { "type": "capture", "from": "pending.json.approvals", "where": { "tool": "web_fetch", "status": "pending" }, "pick": "id", "saveAs": "approvalId" },
    { "type": "http", "method": "POST", "path": "/api/approvals/{{@approvalId}}", "body": { "decision": "allow" }, "expectStatus": 200, "timeoutMs": 90000, "saveAs": "allowResp" },
    {
      "type": "poll",
      "method": "GET",
      "path": "/api/approvals",
      "saveAs": "resolved",
      "intervalMs": 400,
      "timeoutMs": 40000,
      "until": { "path": "json.approvals", "matchSome": { "id": "{{@approvalId}}", "status": "approved" } }
    }
  ],
  "graders": [
    { "type": "regex", "target": "resolved.body", "pattern": "\"tool\"\\s*:\\s*\"web_fetch\"" },
    { "type": "regex", "target": "resolved.body", "pattern": "(\"status\"\\s*:\\s*200|status=200|contentType|text\\\"\\s*:\\s*\\\"[^\\\"]{20,}|Error:|code=)" },
    { "type": "forbidden", "target": "resolved.body", "patterns": ["code=ssrf_blocked"] }
  ]
}
