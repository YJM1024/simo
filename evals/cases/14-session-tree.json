{
  "id": "session-tree",
  "name": "会话树（对话建子需求 → tree 中 main.children 含该子会话，parentId=main）",
  "tier": "critical",
  "vars": {
    "marker": "evals-tree-{{runId}}"
  },
  "steps": [
    {
      "type": "http",
      "method": "GET",
      "path": "/api/sessions/tree",
      "expectStatus": 200,
      "saveAs": "tree1"
    },
    {
      "type": "http",
      "method": "POST",
      "path": "/api/sessions",
      "body": {
        "parentId": "main",
        "title": "{{marker}}",
        "draft": false
      },
      "expectStatus": [
        200,
        201
      ],
      "saveAs": "created"
    },
    {
      "type": "http",
      "method": "GET",
      "path": "/api/sessions/tree",
      "expectStatus": 200,
      "saveAs": "tree2"
    },
    {
      "type": "capture",
      "from": [
        "tree2.json.sessions",
        "tree2.json.tree"
      ],
      "mode": "array",
      "saveAs": "allSessions"
    },
    {
      "type": "capture",
      "from": "allSessions",
      "where": {
        "parentId": "main"
      },
      "saveAs": "mainChildren",
      "mode": "array"
    },
    {
      "type": "capture",
      "from": "mainChildren",
      "whereContains": {
        "title": "{{marker}}"
      },
      "saveAs": "childNode"
    },
    {
      "type": "capture",
      "from": "mainChildren",
      "whereContains": {
        "title": "{{marker}}"
      },
      "pick": "id",
      "saveAs": "childId"
    }
  ],
  "graders": [
    {
      "type": "state_delta",
      "collection": "allSessions",
      "where": {
        "id": "main"
      },
      "atLeast": 1
    },
    {
      "type": "state_delta",
      "collection": "mainChildren",
      "atLeast": 1,
      "expect": {
        "parentId": "main"
      }
    },
    {
      "type": "regex",
      "target": "childNode",
      "pattern": "\"parentId\"\\s*:\\s*\"main\""
    },
    {
      "type": "regex",
      "target": "childNode",
      "pattern": "{{marker}}"
    },
    {
      "type": "forbidden",
      "target": "childId",
      "patterns": [
        "^main$"
      ]
    }
  ]
}
