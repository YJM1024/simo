# agentd 容器镜像（备选：跳过前端构建，仅编译 Go）
#
# 使用场景：容器内 npm registry 不可达 / 想复用本机构建好的前端产物。
# 前置：先在仓库根执行前端构建，确认 agentd/internal/webui/dist 存在：
#   cd web && node build.mjs
#   ls ../agentd/internal/webui/dist  # 期望 index.html / app.js / app.css
#
# 构建（上下文仍为仓库根）：
#   docker build -f deploy/Dockerfile.go-only -t agentd:local .
#
# 与 deploy/Dockerfile 的差异只有一点：没有 node 阶段，dist 从构建上下文拷入；
# 因此其忽略清单 **不能** 排除 agentd/internal/webui/dist
# （见 deploy/Dockerfile.go-only.dockerignore）。
#
# 诚实声明：本机无 Docker/WSL/Podman，本文件**未经过实际构建验证**。

# syntax=docker/dockerfile:1.7

ARG GO_IMAGE=golang:1.27-alpine
ARG RUNTIME_IMAGE=alpine:3.22
ARG TZ=Asia/Shanghai

FROM ${GO_IMAGE} AS build
WORKDIR /src

ARG GOPROXY=https://goproxy.cn,direct
ENV GOPROXY=${GOPROXY} GOSUMDB=off GOTOOLCHAIN=local CGO_ENABLED=0

COPY agentd/go.mod agentd/go.sum ./agentd/
RUN cd agentd && go mod download

COPY agentd/ ./agentd/
# 构建期断言：dist 必须已存在，否则 //go:embed dist 会失败（给出明确错误）
RUN test -f agentd/internal/webui/dist/index.html \
 && test -f agentd/internal/webui/dist/app.js \
 && test -f agentd/internal/webui/dist/app.css \
 && mkdir -p /out \
 && cd agentd \
 && go build -trimpath -buildvcs=false -ldflags="-s -w" -o /out/simo ./cmd/agentd \
 && mkdir -p /out/data

FROM ${RUNTIME_IMAGE} AS runtime
ARG TZ

RUN addgroup -g 10001 -S agentd \
 && adduser -u 10001 -S -G agentd -h /app -s /sbin/nologin agentd \
 && apk add --no-cache ca-certificates tzdata

WORKDIR /app
COPY --from=build /out/simo /simo
RUN mkdir -p /data && chown -R 10001:10001 /data

ENV AGENTD_HOME=/data \
    AGENTD_ADDR=0.0.0.0:8787 \
    AGENTD_MODEL=mock \
    TZ=${TZ}

EXPOSE 8787
VOLUME ["/data"]
USER 10001:10001

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -q -O - http://127.0.0.1:8787/api/health >/dev/null 2>&1 || exit 1

ENTRYPOINT ["/simo", "serve"]
