# ---- secrets & runtime data: never commit ----
backend/config.local.json
data/
.tmp/
.trash/
*.log
logs/
uploads/
artifacts/

# ---- build outputs (rebuild with deploy/package.ps1) ----
*.exe
*.zip
*.sha256
deploy/dist/
backend/internal/webui/dist/
frontend/dist/

# ---- transient test / incident artifacts ----
.leadcheck/
.m17-*/
.m18-*/
.m19-*/
.m20-*/
.m21-*/
.m30-*/
.m40-*/
evals/reports/
evals/incident/
agents/
toolchain/
__pycache__/
*.pyc
*.vhdx

# ---- archived experiments: keep history, ignore generated caches/builds ----
archive/labs/storybook/node_modules/
archive/labs/storybook/storybook-static/
archive/labs/storybook/.cache/
archive/labs/storybook/.home/

# ---- editor / OS noise ----
.git/
.idea/
.vscode/
*.swp
Thumbs.db
.DS_Store
node_modules/
.pnpm-store/
**/.pnpm-store/
*.ignored_*
